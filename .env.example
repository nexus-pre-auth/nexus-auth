# NexusAuth — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Docker (matches docker-compose.yml)
DATABASE_URL=postgresql://nexusauth:nexusauth@localhost:5432/nexusauth

# AWS RDS (production)
# DATABASE_URL=postgresql://nexusauth:YOUR_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/nexusauth

# ---------------------------------------------------------------------------
# Redis (for scraper job queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# OpenAI (required for embedding stage)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Ingestion pipeline settings
# ---------------------------------------------------------------------------
# Max documents per pipeline run (leave blank for no limit)
PIPELINE_MAX_DOCS=

# Batch size for DB operations
PIPELINE_BATCH_SIZE=100

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path (leave blank for stdout only)
LOG_FILE=logs/pipeline.log

# ---------------------------------------------------------------------------
# CMS MCD Download URLs (override for testing with local files)
# ---------------------------------------------------------------------------
CMS_LCD_URL=https://downloads.cms.gov/medicare-coverage-database/downloads/exports/current_lcd.zip
CMS_NCD_URL=https://downloads.cms.gov/medicare-coverage-database/downloads/exports/ncd.zip

# ---------------------------------------------------------------------------
# CMS Extended Data Sources (--extended stage)
# Set these to local ZIP paths (file:///path/to/fixture.zip) for testing.
# Leave blank to use the built-in default URLs derived from the current year.
# ---------------------------------------------------------------------------

# MPFS: Medicare Physician Fee Schedule (annual, Jan update)
# CMS publishes at: https://www.cms.gov/Medicare/Medicare-Fee-for-Service-Payment/PhysicianFeeSched/Downloads
CMS_MPFS_URL=

# NCCI PTP: Procedure-to-Procedure edits (quarterly)
# CMS publishes at: https://www.cms.gov/files/zip/ncci-practitioner-py{yy}.zip
CMS_NCCI_PTP_URL=

# NCCI MUE: Medically Unlikely Edits (quarterly)
# CMS publishes at: https://www.cms.gov/files/zip/ncci-mue-practitioner.zip
CMS_NCCI_MUE_URL=

# OPPS: Outpatient PPS Addendum A and B (annual)
# CMS publishes at: https://www.cms.gov/medicare/medicare-fee-for-service-payment/hospitaloutpatientpps/addenda-and-updates
CMS_OPPS_URL=

# ASP: Average Sales Price quarterly drug pricing
# CMS publishes at: https://www.cms.gov/medicare/medicare-fee-for-service-payment/mcrpartbdrugavgsalesprice/aspfiles
CMS_ASP_URL=

# DRG: MS-DRG definitions and weights (annual, Oct update)
# CMS publishes at: https://www.cms.gov/medicare/medicare-fee-for-service-payment/acuteinpatientpps/ms-drg-classifications-and-software
CMS_DRG_URL=

# RARC: CMS Remittance Advice Remark Codes (HTML page)
CMS_RARC_URL=https://www.cms.gov/medicare/claim-based-resources/remittance-advice-remark-codes

# CARC: Claim Adjustment Reason Codes (X12/WPC HTML page)
CMS_CARC_URL=https://x12.org/codes/claim-adjustment-reason-codes

# ---------------------------------------------------------------------------
# Commercial Payer Policy Sources (--extended stage, payer policies)
# Set to the index page URL for each payer's public policy library.
# ---------------------------------------------------------------------------

# Aetna Clinical Policy Bulletins (CPBs)
AETNA_CPB_URL=https://www.aetna.com/health-care-professionals/clinical-policy-bulletins/medical-clinical-policy-bulletins.html

# UnitedHealthcare Medical Policies
UHC_POLICY_URL=https://www.uhcprovider.com/en/policies-protocols/coverage-policies.html

# Cigna Coverage Policies
CIGNA_POLICY_URL=https://www.cigna.com/healthcare-professionals/coverage-and-reimbursement/clinical-coverage-policy

# Humana Coverage Determination Guidelines
HUMANA_POLICY_URL=https://www.humana.com/provider/medical-resources/medical-clinical-coverage-guidelines
